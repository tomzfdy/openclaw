{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Gateway (native)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk=9229",
        "openclaw.mjs",
        "gateway", "run", "--force"
      ],
      "env": {
        "OUTPUT_SOURCE_MAPS": "1"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**",
        "!**/node_modules/**"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Rebuild and Debug Gateway (native)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "debug:rebuild",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk=9229",
        "openclaw.mjs",
        "gateway", "run", "--force"
      ],
      "env": {
        "OUTPUT_SOURCE_MAPS": "1"
      },
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**",
        "!**/node_modules/**"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
