{
  "version": "2.0.0",
  "options": {
    "env": {
      "OUTPUT_SOURCE_MAPS": "1",
      "OPENCLAW_PROFILE": "dev",
      "OPENCLAW_GATEWAY_PORT": "19006",
      "OPENCLAW_SKIP_CHANNELS": "1"
    }
  },
  "tasks": [
    {
      "label": "debug:rebuild",
      "type": "shell",
      "command": "pnpm clean:dist && pnpm build",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "debug:start-gateway-inspect",
      "type": "shell",
      "command": "node",
      "args": [
        "--inspect=19006",
        "--stack-size=8192",
        "./dist/entry.js",
        "gateway",
        "run",
        "--dev"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "ready"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}